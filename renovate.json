{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":disableDependencyDashboard"],
  "ignoreDeps": ["System.Resources.Extensions"],
  "packageRules": [
    {
      "matchPackagePatterns": ["^gittools"],
      "allowedVersions": "<4"
    },
    {
      "matchPackageNames": ["dotnet-sdk"],
      "matchUpdateTypes": ["patch"],
      "enabled": false,
      "description": "Using automatic roll-forward instead of explicit update"
    },
    {
      "matchPackagePatterns": ["^Generator\\.Equals"],
      "groupName": "Generator.Equals",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackageNames": ["wix"],
      "automerge": true,
      "automergeType": "branch",
      "allowedVersions": "<7"
    },
    {
      "matchPackageNames": ["ILRepack", "AeroWizard"],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}

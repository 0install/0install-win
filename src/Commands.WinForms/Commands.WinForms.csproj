<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project properties -->
  <PropertyGroup>
    <RootNamespace>ZeroInstall.Commands.WinForms</RootNamespace>
    <AssemblyName>0install-win</AssemblyName>
    <Description>A GUI for Zero Install, for installing and launching applications, managing caches, etc.</Description>
    <OutputType>WinExe</OutputType>
    <OutputPath>..\..\artifacts\$(Configuration)\</OutputPath>
    <UseWindowsForms>True</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>ERROR_REPORT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\App.config" />
  </ItemGroup>

  <!-- Global usings -->
  <ItemGroup>
    <Using Include="Eto.Forms" />
    <Using Include="NanoByte.Common.EtoControls" />
    <Using Include="ZeroInstall.Commands.EtoForms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <PackageReference Include="ZeroInstall.Commands.EtoForms" Version="$(ZeroInstallVersion)" />
    <PackageReference Include="Eto.Platform.Windows" Version="2.13.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Windows.Data" />
    <Reference Include="Windows.UI" />
  </ItemGroup>

</Project>
